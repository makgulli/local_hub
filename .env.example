# LocalHub 프론트엔드 환경변수 예시
# 실제 값을 채운 뒤 파일명을 .env 로 바꿔서 사용하세요.
# .env 파일은 .gitignore 에 등록되어 있어 절대 커밋되지 않습니다.
#
# ⚠️ Vite 의 VITE_ 접두사 값은 빌드 결과물(JS 번들)에 그대로 노출됩니다.
#    반드시 "사용량 제한(rate limit)"이 걸린 키만 사용하고,
#    OpenAI 대시보드에서 결제 한도(Usage limit)를 낮게 설정하세요.
#    (RFP III-3-가 주의사항 참고)

# 회사에서 발급한 OpenAI API 키
VITE_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 모델 (예산 절감을 위해 기본값은 저비용 모델 사용을 권장)
VITE_OPENAI_MODEL=gpt-5-mini
